{
  "name": "@mobile-ide/server",
  "version": "0.1.0",
  "description": "mobile-ide daemon: drives Claude Code, Codex, OpenCode (any ACP agent) and exposes them to your phone with a durable event log.",
  "type": "module",
  "bin": { "mide": "./bin/mide.js" },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts serve",
    "test": "node --test --import tsx --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@hono/node-server": "^1.14.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@mobile-ide/core": "workspace:*",
    "commander": "^14.0.0",
    "hono": "^4.13.5",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

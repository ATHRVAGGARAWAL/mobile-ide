{
  "name": "@mobile-ide/studio",
  "version": "0.1.0",
  "private": true,
  "description": "The Studio: the laptop-side live editor for mobile-ide — files change on screen as the agent edits them. Served by the daemon at /studio/.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/language": "^6.12.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.13",
    "@lezer/highlight": "^1.2.3",
    "@mobile-ide/core": "workspace:*",
    "diff": "^9.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0"
  }
}
